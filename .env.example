JWT_SECRET_KEY=
JWT_EXPIRES=7d

# Shared outbound request timeout (ms) for webhooks, Bitget proxy, Swagger notify, IP lookup, etc.
TIMEOUT_MS=5000

# When set, /swagger requires a password; /api/* stays public.
SWAGGER_PASSWORD=
# Server-side only: on successful Swagger login the API POSTs client info here
# (e.g. Discord webhook URL). Not called from the browser.
# SWAGGER_AUTH_NOTIFY_URL=

# Webhook relay: POST /api/webhooks routes by `destination` to WEBHOOK_<DESTINATION>_URL.
# Add one env var per destination, e.g.:
WEBHOOK_DISCORD_URL=
# WEBHOOK_SLACK_URL=

# Bitget instruction-mode API (server-side proxy for /api/bitget/dex/*)
BITGET_API_URL=https://bopenapi.bgwapi.io
BITGET_API_KEY=
BITGET_API_SECRET=

# OKX DEX aggregator (server-side proxy for /api/okx/dex/*)
OKX_API_URL=https://web3.okx.com
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
