{
  "name": "ethan-dapp-server",
  "version": "0.1.3",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/EthanOK/ethan-dapp-server.git"
  },
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --hot src/server/index.ts",
    "build": "bun build ./src/client/index.html --outdir=public --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "test": "bun test",
    "fmt": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"test/**/*.{ts,tsx}\" \"*.{json,md,yaml}\"",
    "lint": "tsc --noEmit",
    "release": "bunx standard-version"
  },
  "dependencies": {
    "@ambire/signature-validator": "^1.5.0",
    "@hono/zod-openapi": "^1.4.0",
    "ethers": "^6.17.0",
    "hono": "^4.12.27",
    "jsonwebtoken": "^9.0.3",
    "react": "^19",
    "react-dom": "^19",
    "siwe": "^3.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.9.4",
    "standard-version": "^9.5.0",
    "typescript": "^6.0.3"
  }
}
